<div class="row g-3">
  <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><h5>Coins Saved</h5><p class="display-6 mb-0"><%= data.piggyBank.coins %></p></div></div></div>
  <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><h5>Notes Saved</h5><p class="display-6 mb-0"><%= data.piggyBank.notes %></p></div></div></div>
